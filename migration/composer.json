    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "laminas/laminas-dependency-plugin": true,
            "magento/*": true,
            "php-http/discovery": true
        },
        "preferred-install": {
            "agrekom/*": "source",
            "e-warsztat/*": "source",
            "creativestyle/theme-agrekom": "source",
            "creativestyle/theme-ewarsztat": "source",
            "*": "dist"
        },
        "sort-packages": true
    },
    "version": "2.4.9",
    "require": {
        "agrekom/aitoc-advanced-permissions-module": "^2.0",
        "agrekom/alior-bank-raty-module": "^2.0",
        "agrekom/category-module": "^2.0",
        "agrekom/contact-module": "^2.0",
        "agrekom/core-module": "^2.0",
        "agrekom/customer-module": "^2.0",
        "agrekom/customization-email-template": "^2.0",
        "agrekom/customization-magesuite-lowest-price-logger-frontend": "^2.0",
        "agrekom/customization-payment": "^2.0",
        "agrekom/filter-url-alias-module": "^2.0",
        "agrekom/flipbook-module": "^2.0",
        "agrekom/imoje-payment-gateway-module": "^2.0",
        "agrekom/language-de_de": "^2.0",
        "agrekom/language-pl_pl": "^2.0",
        "agrekom/olegnax-hotspot-quick-view-module": "^2.0",
        "agrekom/product-configurator-module": "^2.0",
        "agrekom/product-module": "^2.0",
        "agrekom/send-order-to-google-analytics-module": "^2.0",
        "agrekom/video-promotional-campaign-module": "^2.0",
        "creativestyle/magesuite": "^13.0",
        "creativestyle/magesuite-email-attachments": "4.1.1 as 3.99.0",
        "creativestyle/theme-agrekom": "^2.0",
        "creativestyle/theme-creativeshop": "^19.13",
        "creativestyle/theme-ewarsztat": "^2.0",
        "e-warsztat/core-module": "^2.0",
        "jflight/gacookie": "dev-master",
        "magento/composer": "^1.10.1-beta1",
        "magento/composer-dependency-version-audit-plugin": "~0.1",
        "magento/composer-root-update-plugin": "^2.0.4",
        "magento/product-community-edition": "2.4.9",
        "snowdog/language-pl_pl": "^0.10.0",
        "splendidinternet/mage2-locale-de-de": "^1.71"
    },
    "autoload": {
        "exclude-from-classmap": [
            "**/dev/**",
            "**/update/**",
            "**/Test/Fixture/**",
            "**/Test/Integration/**",
            "**/Test/Mftf/**",
            "**/Test/Unit/**"
        ],
        "files": [
            "app/etc/NonComposerComponentRegistration.php"
        ],
        "psr-0": {
            "": [
                "app/code/",
                "generated/code/"
            ]
        },
        "psr-4": {
            "Magento\\Setup\\": "setup/src/Magento/Setup/"
        }
    },
    "require-dev": {
        "allure-framework/allure-phpunit": "^3.2",
        "dealerdirect/phpcodesniffer-composer-installer": "^0.7 || ^1.0",
        "dg/bypass-finals": "^1.4",
        "friendsofphp/php-cs-fixer": "^3.22",
        "magento/magento-coding-standard": "*",
        "magento/magento2-functional-testing-framework": "^6.0",
        "pdepend/pdepend": "^3@dev",
        "phpmd/phpmd": "^3@dev",
        "phpstan/phpstan": "^1.9",
        "phpunit/phpunit": "^12.0",
        "symfony/finder": "^7.4"
    },
    "conflict": {
        "gene/bluefoot": "*"
    },
    "autoload-dev": {
        "psr-4": {
            "Magento\\PhpStan\\": "dev/tests/static/framework/Magento/PhpStan/",
            "Magento\\Sniffs\\": "dev/tests/static/framework/Magento/Sniffs/",
            "Magento\\TestFramework\\Inspection\\": "dev/tests/static/framework/Magento/TestFramework/Inspection/",
            "Magento\\TestFramework\\Utility\\": "dev/tests/static/framework/Magento/TestFramework/Utility/",
            "Magento\\Tools\\": "dev/tools/Magento/Tools/",
            "Magento\\Tools\\Sanity\\": "dev/build/publication/sanity/Magento/Tools/Sanity/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
