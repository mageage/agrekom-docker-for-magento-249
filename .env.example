COMPOSE_PROJECT_NAME=agrekom_249
# Magento root mounted into containers. ./src = fresh install, or an absolute path to the agrekom project
MAGENTO_SRC=./src
# Private key with access to bitbucket.org/agrekom and github.com/jarekherisz (mounted read-only)
SSH_KEY=~/.ssh/id_rsa
HTTP_PORT=8080
DB_PORT=3306
MAILPIT_PORT=8025
RABBITMQ_UI_PORT=15672
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=magento
MYSQL_USER=magento
MYSQL_PASSWORD=magento
