COMPOSE_PROJECT_NAME=agrekom_249
# Magento root mounted into containers. ./src = fresh install, or an absolute path to the agrekom project
MAGENTO_SRC=./src
# Private key with access to bitbucket.org/agrekom and github.com/jarekherisz (mounted read-only)
SSH_KEY=~/.ssh/id_rsa
# known_hosts with the deploy servers (web01.agrekom.pl), mounted into the deployer container
SSH_KNOWN_HOSTS=~/.ssh/known_hosts
# Your git config (user.name / user.email) for commits made inside the php container
GITCONFIG=~/.gitconfig
HTTP_PORT=8080
DB_PORT=3306
MAILPIT_PORT=8025
RABBITMQ_UI_PORT=15672
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=magento
MYSQL_USER=magento
MYSQL_PASSWORD=magento
